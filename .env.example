# Supabase プロジェクト設定 > API から取得します
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# メール確認リンクやパスワード再設定リンクの戻り先（本番は公開URL）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 招待メールの送信元。未設定なら送信しません（アプリ内のお知らせとコード共有のみ）
# resend を指定する場合は RESEND_API_KEY と EMAIL_FROM もあわせて設定します
# 別の提供元を足すときは src/lib/email/ に Mailer を実装して、その id を指定します
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# EMAIL_FROM=おでかけ記録 <noreply@example.com>
# EMAIL_REPLY_TO=support@example.com

# Google Places API（New）のサーバー用APIキー。
# ブラウザへ公開せず、VercelのEnvironment Variablesへ登録します。
# GOOGLE_PLACES_API_KEY=AIza...

# --- ここから下は scripts/verify-supabase.mjs（手元での動作確認）専用です ---
# アプリ本体のコードでは読み込みません。本番環境には設定しないでください
# SUPABASE_SERVICE_ROLE_KEY=
