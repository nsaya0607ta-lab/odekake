# Supabase プロジェクト設定 > API から取得します
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# メール確認リンクやパスワード再設定リンクの戻り先（本番は公開URL）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 招待メールの送信元。未設定なら送信しません（招待コードとリンクの共有のみ）
# 送信を追加するときは src/lib/email/ に Mailer を実装して、その id を指定します
# EMAIL_PROVIDER=none

# 店舗・施設検索の提供元。未設定なら検索欄は使えません
# 追加するときは src/lib/places/ に PlaceSearchProvider を実装して、その id を指定します
# NEXT_PUBLIC_PLACE_SEARCH_PROVIDER=none

# --- ここから下は scripts/verify-supabase.mjs（手元での動作確認）専用です ---
# アプリ本体のコードでは読み込みません。本番環境には設定しないでください
# SUPABASE_SERVICE_ROLE_KEY=
